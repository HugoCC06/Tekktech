# ---------------------------------------------------------------------------
# TekkTech environment variables
# Copy to .env for local use. Never commit real values.
# Variables prefixed PUBLIC_ are embedded in the public website — never put
# secrets in them.
# ---------------------------------------------------------------------------

# --- Website build (set in Cloudflare Pages > Settings > Variables) --------

# Canonical production URL. Defaults to https://tekktech.com when unset.
# Set this to your *.pages.dev URL if you launch before the domain is ready.
SITE_URL=

# Optional sub-directory base path, e.g. /tekktech. Leave empty for root.
BASE_PATH=

# Force a preview (noindex) build. Cloudflare preview branches are detected
# automatically, so this is rarely needed.
DEPLOY_ENV=

# Node version used by the Cloudflare build image.
NODE_VERSION=22

# --- Analytics (optional, privacy-conscious) ---------------------------------
# One of: none | plausible | cloudflare | umami
PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: your site domain as registered in Plausible, e.g. tekktech.com
PUBLIC_PLAUSIBLE_DOMAIN=
# Cloudflare Web Analytics: the beacon token from the Cloudflare dashboard
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# Umami: script URL and website ID
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# --- Newsletter (optional) ---------------------------------------------------
# One of: none | buttondown | form
PUBLIC_NEWSLETTER_PROVIDER=none
# Buttondown username (the newsletter will post to Buttondown's embed form)
PUBLIC_BUTTONDOWN_USERNAME=
# Generic provider: a form action URL that accepts an "email" field via POST
PUBLIC_NEWSLETTER_FORM_ACTION=
PUBLIC_NEWSLETTER_EMAIL_FIELD=email

# --- Advertising (optional, leave disabled until a provider is approved) ----
PUBLIC_ADS_ENABLED=false

# ---------------------------------------------------------------------------
# CMS authentication — SERVER-SIDE SECRETS
# Set these in Cloudflare Pages > Settings > Variables and Secrets as
# *encrypted secrets* (or in .dev.vars for `wrangler pages dev`).
# They are read only by functions/oauth/[[route]].ts and never reach the
# browser.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to sign in to /admin/.
# If empty, nobody can sign in (fail closed).
ALLOWED_GITHUB_USERS=
# owner/repo that holds the content; the signed-in user must have push access.
GITHUB_REPO=hugocc06/tekktech
# OAuth scope for a classic OAuth App ("repo" for private repos,
# "public_repo" for public ones). Ignored by GitHub Apps.
OAUTH_SCOPE=repo
