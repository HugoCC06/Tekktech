---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { categories } from '../../site.config.ts';
import { getCategory, getPublishedArticles } from '../../lib/articles.ts';
import { paginatedPaths, type ListingPageProps } from '../../lib/listing.ts';

export const getStaticPaths = (async () => {
  const articles = await getPublishedArticles();
  return categories.flatMap((category) =>
    paginatedPaths(
      articles.filter((article) => article.data.category === category.slug),
      { category: category.slug },
    ),
  );
}) satisfies GetStaticPaths;

const { category: slug } = Astro.params;
const category = getCategory(slug);
const { articles, page, totalPages, totalArticles } = Astro.props as ListingPageProps;
---

<ListingLayout
  title={category.name}
  eyebrow="Category"
  intro={category.intro}
  description={`${category.summary} Reviews, comparisons and explainers from TekkTech.`}
  articles={articles}
  basePath={`/${category.slug}/`}
  page={page}
  totalPages={totalPages}
  totalArticles={totalArticles}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: category.name, path: `/${category.slug}/` },
  ]}
  currentCategory={category.slug}
  showCategorySwitcher
  emptyMessage={`We haven't published any ${category.name} articles yet. Check back soon, or explore our other categories.`}
/>
