---
/**
 * Site search, powered by Pagefind: a static index generated after each
 * build from published article pages only (`data-pagefind-body`). Drafts are
 * never built, so they can never appear in results. No external service.
 */
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../site.config.ts';
import { withBase } from '../lib/urls.ts';
---

<BaseLayout title="Search" description="Search TekkTech reviews, comparisons, guides and explainers." noindex>
  <div class="container container--narrow search-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Search', path: '/search/' },
      ]}
    />

    <header class="search-page__header">
      <h1>Search TekkTech</h1>
      <p>Find reviews, comparisons, guides and explainers.</p>
    </header>

    <form class="search-form" role="search" action={withBase('/search/')} method="get" data-search-form>
      <label class="visually-hidden" for="search-input">
        Search articles
      </label>
      <Icon name="search" class="icon search-form__icon" />
      <input
        id="search-input"
        class="search-form__input"
        type="search"
        name="q"
        placeholder="Search articles, e.g. “wallet” or “OLED”"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="search-status"
        data-search-input
      />
      <button class="button search-form__submit" type="submit">
        Search
      </button>
    </form>

    <p id="search-status" class="search-status" role="status" aria-live="polite" data-search-status></p>

    <ol class="search-results" data-search-results></ol>

    <noscript>
      <p class="notice">
        Search needs JavaScript. You can still browse every article from the
        <a href={withBase('/articles/')}>articles page</a> or by category below.
      </p>
    </noscript>

    <section class="search-browse" aria-labelledby="browse-title">
      <h2 id="browse-title">Browse by category</h2>
      <ul>
        {categories.map((category) => (
          <li>
            <a href={withBase(`/${category.slug}/`)}>{category.name}</a>
          </li>
        ))}
        <li>
          <a href={withBase('/reviews/')}>Reviews & buying advice</a>
        </li>
        <li>
          <a href={withBase('/guides/')}>Guides & explainers</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string; category?: string; type?: string; date?: string };
  }
  interface Pagefind {
    init: () => Promise<void>;
    debouncedSearch: (
      query: string,
      options?: object,
      debounceMs?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindResultData> }[] } | null>;
  }

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const list = document.querySelector<HTMLOListElement>('[data-search-results]');
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  let pagefind: Pagefind | null = null;
  let loadFailed = false;

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind || loadFailed) return pagefind;
    try {
      const module = (await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`)) as Pagefind;
      await module.init();
      pagefind = module;
    } catch {
      loadFailed = true;
    }
    return pagefind;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  async function runSearch(query: string) {
    if (!list) return;
    const term = query.trim();
    const url = new URL(window.location.href);
    if (term) url.searchParams.set('q', term);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);

    if (!term) {
      list.innerHTML = '';
      setStatus('');
      return;
    }

    const engine = await loadPagefind();
    if (!engine) {
      setStatus(
        'Search is unavailable right now. The search index is created when the site is built — run “npm run build” then “npm run preview” locally.',
      );
      return;
    }

    const search = await engine.debouncedSearch(term, {}, 200);
    if (search === null) return; // superseded by a newer query
    const results = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));

    if (results.length === 0) {
      list.innerHTML = '';
      setStatus(`No articles match “${term}”. Try a broader word, check the spelling, or browse a category below.`);
      return;
    }

    setStatus(`${results.length} ${results.length === 1 ? 'result' : 'results'} for “${term}”`);
    // Excerpts come from our own build-time index; Pagefind escapes page text
    // and adds only <mark> highlighting.
    list.innerHTML = results
      .map((result) => {
        const meta = [result.meta.category, result.meta.type, result.meta.date]
          .filter(Boolean)
          .map((value) => escapeHtml(value!));
        return `<li class="search-result">
          <p class="search-result__meta">${meta.join('<span aria-hidden="true"> · </span>')}</p>
          <h2 class="search-result__title"><a href="${escapeHtml(result.url)}">${escapeHtml(result.meta.title ?? 'Untitled')}</a></h2>
          <p class="search-result__excerpt">${result.excerpt}</p>
        </li>`;
      })
      .join('');
  }

  if (form && input) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void runSearch(input.value);
    });
    input.addEventListener('input', () => void runSearch(input.value));
    input.addEventListener('focus', () => void loadPagefind(), { once: true });

    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      void runSearch(initial);
    }
    input.focus();
  }
</script>

<style>
  .search-page__header {
    padding-block: var(--space-6) var(--space-8);
  }

  .search-page__header h1 {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-display);
  }

  .search-page__header p {
    margin-top: var(--space-2);
    color: var(--color-ink-2);
  }

  .search-form {
    position: relative;
    display: flex;
    gap: var(--space-2);
  }

  .search-form :global(.search-form__icon) {
    position: absolute;
    top: 50%;
    left: var(--space-4);
    color: var(--color-ink-3);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-form__input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    padding: 0 var(--space-4) 0 3rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-md);
    box-shadow: var(--shadow-sm);
  }

  .search-form__input:focus-visible {
    border-color: var(--color-accent);
    outline: 3px solid rgb(36 67 214 / 0.2);
    outline-offset: 0;
  }

  .search-form__submit {
    height: 3.25rem;
  }

  .search-status {
    min-height: 1.5rem;
    margin-top: var(--space-5);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }

  .search-results {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .search-results :global(.search-result) {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .search-results :global(.search-result__meta) {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .search-results :global(.search-result__title) {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
  }

  .search-results :global(.search-result__title a) {
    color: var(--color-ink);
    text-decoration: none;
  }

  .search-results :global(.search-result__title a:hover) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .search-results :global(.search-result__excerpt) {
    margin-top: var(--space-2);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }

  .search-results :global(mark) {
    background: #fff1c2;
    color: inherit;
    border-radius: 2px;
  }

  .search-browse {
    margin-top: var(--space-16);
  }

  .search-browse h2 {
    font-size: var(--text-md);
  }

  .search-browse ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .search-browse a {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .search-browse a:hover {
    border-color: var(--color-ink-3);
    color: var(--color-ink);
  }

  @media (max-width: 30rem) {
    .search-form__submit {
      display: none;
    }
  }
</style>
