---
/** The homepage lead story: the largest, most prominent article slot. */
import { articlePath, getCategory, typeLabel, type Article } from '../lib/articles.ts';
import { withBase } from '../lib/urls.ts';
import ArticleImage from './ArticleImage.astro';
import ArticleMeta from './ArticleMeta.astro';
import Icon from './Icon.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const category = getCategory(article.data.category);
const hasImage = Boolean(article.data.image);
---

<article class:list={['featured', { 'featured--text': !hasImage }]}>
  {hasImage && (
    <div class="featured__media">
      <ArticleImage
        article={article}
        sizes="(min-width: 76rem) 760px, (min-width: 60rem) 62vw, 100vw"
        widths={[480, 760, 1024, 1520]}
        priority
        decorative
      />
    </div>
  )}
  <div class="featured__body">
    <p class="eyebrow featured__eyebrow">
      <a href={withBase(`/${category.slug}/`)}>{category.name}</a>
      <span class="eyebrow__sep" aria-hidden="true">
        /
      </span>
      <span class="eyebrow__muted">{typeLabel(article.data.type)}</span>
    </p>
    <h2 class="featured__title">
      <a href={articlePath(article)}>{article.data.title}</a>
    </h2>
    <p class="featured__excerpt">{article.data.excerpt}</p>
    <ArticleMeta article={article} />
    {!hasImage && (
      <span class="featured__cta" aria-hidden="true">
        Read the article <Icon name="arrow-right" />
      </span>
    )}
  </div>
</article>

<style>
  .featured {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }

  .featured__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
  }

  .featured__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .featured:hover .featured__media :global(img) {
    transform: scale(1.02);
  }

  .featured__body {
    display: grid;
    gap: var(--space-3);
  }

  .featured__eyebrow {
    position: relative;
    z-index: 1;
  }

  .featured__title {
    font-size: var(--text-3xl);
    font-weight: 680;
    letter-spacing: var(--tracking-display);
  }

  .featured__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .featured__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .featured__title a:focus-visible {
    outline: none;
  }

  .featured__title a:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }

  .featured:hover .featured__title a {
    color: var(--color-accent);
  }

  .featured__excerpt {
    max-width: 40rem;
    color: var(--color-ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }

  /* Typographic lead story for articles without an image */
  .featured--text {
    overflow: hidden;
    padding: var(--space-10) var(--space-6);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 90% at 100% 0%, rgb(36 67 214 / 0.35), transparent 60%), var(--color-ink);
    color: #fff;
  }

  .featured--text .featured__body {
    gap: var(--space-4);
    max-width: 44rem;
  }

  .featured--text .featured__eyebrow,
  .featured--text .featured__eyebrow :global(.eyebrow__muted) {
    color: #b9c6ff;
  }

  .featured--text .featured__title {
    font-size: var(--text-display);
  }

  .featured--text .featured__title a,
  .featured--text:hover .featured__title a {
    color: #fff;
  }

  .featured--text .featured__excerpt {
    color: #c9cdd6;
    font-size: var(--text-lg);
  }

  .featured--text :global(.article-meta) {
    color: #a9aeb9;
  }

  .featured__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .featured__cta :global(.icon) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration) var(--ease);
  }

  .featured--text:hover .featured__cta :global(.icon) {
    transform: translateX(3px);
  }

  .featured--text :global(.featured__title a:focus-visible::after) {
    outline-color: #b9c6ff;
  }

  @media (min-width: 48rem) {
    .featured--text {
      padding: var(--space-16) var(--space-12);
    }
  }
</style>
