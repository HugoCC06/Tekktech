---
import { withBase } from '../lib/urls.ts';
import Icon from './Icon.astro';

interface Props {
  title: string;
  id?: string;
  description?: string;
  link?: { href: string; label: string };
}

const { title, id, description, link } = Astro.props;
---

<div class="section-header">
  <div>
    <h2 id={id} class="section-header__title">
      {title}
    </h2>
    {description && <p class="section-header__description">{description}</p>}
  </div>
  {link && (
    <a class="text-link section-header__link" href={withBase(link.href)}>
      {link.label}
      <Icon name="arrow-right" class="icon section-header__icon" />
    </a>
  )}
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-ink);
  }

  .section-header__title {
    font-size: var(--text-2xl);
  }

  .section-header__description {
    margin-top: var(--space-2);
    max-width: 38rem;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }

  .section-header__link {
    color: var(--color-ink);
  }

  .section-header__link:hover {
    color: var(--color-accent);
  }

  .section-header__link :global(.section-header__icon) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration) var(--ease);
  }

  .section-header__link:hover :global(.section-header__icon) {
    transform: translateX(2px);
  }
</style>
