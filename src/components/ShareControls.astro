---
/**
 * Share controls: plain share links (work without JavaScript), plus a
 * native-share button and a copy-link button revealed only when the
 * browser supports them.
 */
import Icon from './Icon.astro';

interface Props {
  url: string;
  title: string;
  label?: string;
}

const { url, title, label = 'Share this article' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const networks = [
  { name: 'X', icon: 'x', href: `https://x.com/intent/post?url=${encodedUrl}&text=${encodedTitle}` },
  { name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { name: 'Reddit', icon: 'reddit', href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}` },
  { name: 'Email', icon: 'mail', href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}` },
] as const;
---

<div class="share" data-share data-share-url={url} data-share-title={title}>
  <p class="share__label">{label}</p>
  <ul class="share__list">
    <li hidden data-share-native-item>
      <button type="button" class="share__button" data-share-native aria-label="Share using your device">
        <Icon name="share" />
      </button>
    </li>
    {
      networks.map((network) => (
        <li>
          <a
            class="share__button"
            href={network.href}
            target={network.icon === 'mail' ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={`Share on ${network.name}`}
          >
            <Icon name={network.icon} />
          </a>
        </li>
      ))
    }
    <li hidden data-share-copy-item>
      <button type="button" class="share__button share__button--copy" data-share-copy>
        <Icon name="link" />
        <span data-share-copy-text>Copy link</span>
      </button>
    </li>
  </ul>
  <p class="visually-hidden" role="status" aria-live="polite" data-share-status></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const url = root.dataset.shareUrl ?? window.location.href;
    const title = root.dataset.shareTitle ?? document.title;
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    const copyItem = root.querySelector<HTMLElement>('[data-share-copy-item]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const copyText = root.querySelector<HTMLElement>('[data-share-copy-text]');
    const nativeItem = root.querySelector<HTMLElement>('[data-share-native-item]');
    const nativeButton = root.querySelector<HTMLButtonElement>('[data-share-native]');

    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    if (copyItem && copyButton && copyText) {
      copyItem.hidden = false;
      let timer: number | undefined;
      copyButton.addEventListener('click', async () => {
        let copied = false;
        try {
          await navigator.clipboard.writeText(url);
          copied = true;
        } catch {
          // Fallback for browsers without the async clipboard API.
          const field = document.createElement('textarea');
          field.value = url;
          field.setAttribute('readonly', '');
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.append(field);
          field.select();
          copied = document.execCommand('copy');
          field.remove();
        }
        copyText.textContent = copied ? 'Link copied' : 'Copy failed';
        copyButton.dataset.state = copied ? 'copied' : 'error';
        announce(copied ? 'Link copied to clipboard' : 'Could not copy the link. Copy it from the address bar.');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          copyText.textContent = 'Copy link';
          delete copyButton.dataset.state;
        }, 2500);
      });
    }

    if (nativeItem && nativeButton && typeof navigator.share === 'function') {
      nativeItem.hidden = false;
      nativeButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url });
        } catch {
          // The visitor dismissed the share sheet; nothing to do.
        }
      });
    }
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .share__label {
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .share__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .share__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .share__button :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .share__button:hover {
    border-color: var(--color-ink-3);
    color: var(--color-ink);
  }

  .share__button--copy {
    padding: 0 var(--space-4) 0 var(--space-3);
  }

  .share__button[data-state='copied'] {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .share__button[data-state='error'] {
    border-color: var(--color-error);
    color: var(--color-error);
  }
</style>
