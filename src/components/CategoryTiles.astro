---
import { categories } from '../site.config.ts';
import { withBase } from '../lib/urls.ts';
import Icon from './Icon.astro';

interface Props {
  /** Published article count per category slug (real counts only). */
  counts: Record<string, number>;
}

const { counts } = Astro.props;
---

<ul class="category-tiles">
  {
    categories.map((category, index) => (
      <li class="category-tile" style={`--tile-index: ${index}`}>
        <a href={withBase(`/${category.slug}/`)}>
          <span class="category-tile__index" aria-hidden="true">
            0{index + 1}
          </span>
          <span class="category-tile__name">{category.name}</span>
          <span class="category-tile__summary">{category.summary}</span>
          <span class="category-tile__footer">
            <span>{counts[category.slug] === 1 ? '1 article' : `${counts[category.slug] ?? 0} articles`}</span>
            <Icon name="arrow-right" />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .category-tiles {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .category-tile a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .category-tile a:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .category-tile__index {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .category-tile__name {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .category-tile__summary {
    flex: 1;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .category-tile__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-3);
    font-size: var(--text-xs);
  }

  .category-tile__footer :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--color-ink);
    transition: transform var(--duration) var(--ease);
  }

  .category-tile a:hover .category-tile__footer :global(.icon) {
    transform: translateX(3px);
    color: var(--color-accent);
  }
</style>
