---
/**
 * The TekkTech wordmark, rendered from outlined path data
 * (src/assets/brand/wordmark.json, generated by `npm run brand`).
 */
import wordmark from '../assets/brand/wordmark.json';

interface Props {
  /** Rendered height in pixels; width follows the aspect ratio. */
  height?: number;
  inverse?: boolean;
  class?: string;
}

const { height = 22, inverse = false, class: className } = Astro.props;
const width = Math.round((wordmark.width / wordmark.height) * height);
---

<svg
  class:list={['logo', { 'logo--inverse': inverse }, className]}
  viewBox={wordmark.viewBox}
  width={width}
  height={height}
  role="img"
  aria-label="TekkTech"
>
  <path class="logo__tekk" d={wordmark.tekk}></path>
  <path class="logo__tech" d={wordmark.tech}></path>
</svg>

<style>
  .logo {
    display: block;
    overflow: visible;
  }
  .logo__tekk {
    fill: var(--color-ink);
  }
  .logo__tech {
    fill: var(--color-accent);
  }
  .logo--inverse .logo__tekk {
    fill: #fff;
  }
  .logo--inverse .logo__tech {
    fill: #afc0ff;
  }
</style>
