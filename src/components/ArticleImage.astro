---
/**
 * Responsive article image. Renders nothing when the article has no image —
 * the surrounding components then switch to a text-only layout instead of
 * showing an empty frame.
 */
import { Image } from 'astro:assets';
import type { Article } from '../lib/articles.ts';

interface Props {
  article: Article;
  /** `sizes` attribute describing the rendered width. */
  sizes: string;
  widths?: number[];
  /** Eager-load above-the-fold images (the LCP image). */
  priority?: boolean;
  class?: string;
  /** Decorative in cards, where the headline already describes the link. */
  decorative?: boolean;
}

const {
  article,
  sizes,
  widths = [400, 640, 960, 1280],
  priority = false,
  class: className,
  decorative = false,
} = Astro.props;

const src = article.data.image;
const alt = decorative ? '' : (article.data.imageAlt ?? '');
---

{src && (
  <Image
    src={src}
    alt={alt}
    widths={widths.filter((width) => width <= src.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    format="webp"
    quality={78}
    class={className}
  />
)}
