---
/**
 * Responsive article image with a category illustration as fallback, so a
 * missing featured image never produces a broken or empty frame.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Article } from '../lib/articles.ts';

interface Props {
  article: Article;
  /** `sizes` attribute describing the rendered width. */
  sizes: string;
  widths?: number[];
  /** Eager-load above-the-fold images (the LCP image). */
  priority?: boolean;
  class?: string;
  /** Decorative in cards, where the headline already describes the link. */
  decorative?: boolean;
}

const fallbacks = import.meta.glob<{ default: ImageMetadata }>('../assets/images/fallback/*.webp', { eager: true });

const {
  article,
  sizes,
  widths = [400, 640, 960, 1280],
  priority = false,
  class: className,
  decorative = false,
} = Astro.props;

const fallback = fallbacks[`../assets/images/fallback/${article.data.category}.webp`]?.default;
const src = article.data.image ?? fallback;
const alt = decorative ? '' : article.data.image ? (article.data.imageAlt ?? '') : '';
---

{src && (
  <Image
    src={src}
    alt={alt}
    widths={widths.filter((width) => width <= src.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    format="webp"
    quality={78}
    class={className}
  />
)}
