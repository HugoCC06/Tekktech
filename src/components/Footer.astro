---
import { footerNavigation, site, socialProfiles } from '../site.config.ts';
import { withBase } from '../lib/urls.ts';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={withBase('/')} aria-label="TekkTech home">
          <Logo height={22} />
        </a>
        <p>
          An independent technology publication. Honest reviews, fair comparisons and clear explanations — written for
          people who care about technology.
        </p>
      </div>

      {footerNavigation.sections.map((section) => (
        <nav class="site-footer__section" aria-label={section.title}>
          <h2>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={withBase(link.href)}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.name}. All rights reserved.
      </p>
      {socialProfiles.length > 0 && (
        <ul class="site-footer__social">
          {socialProfiles.map((profile) => (
            <li>
              <a href={profile.url} rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <p>
        <a href={withBase('/affiliate-disclosure/')}>How we handle affiliate links</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding-block: var(--space-16) var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-10) var(--space-8);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__brand {
    grid-column: 1 / -1;
    max-width: 22rem;
  }

  .site-footer__brand p {
    margin-top: var(--space-4);
    color: var(--color-ink-2);
    line-height: var(--leading-normal);
  }

  .site-footer__section h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .site-footer__section ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-3);
    font-size: var(--text-xs);
  }

  .site-footer__bottom a {
    color: var(--color-ink-2);
    text-decoration: underline;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
