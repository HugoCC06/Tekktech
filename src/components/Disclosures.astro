---
/**
 * Editorial disclosures shown at the top of an article: demonstration
 * content, sponsorship and affiliate relationships. Sponsored and affiliate
 * notices appear before the content so readers see them before any links.
 */
import { withBase } from '../lib/urls.ts';
import Icon from './Icon.astro';

interface Props {
  demo: boolean;
  sponsored: boolean;
  sponsorName?: string;
  affiliate: boolean;
}

const { demo, sponsored, sponsorName, affiliate } = Astro.props;
---

{
  (demo || sponsored || affiliate) && (
    <div class="disclosures">
      {demo && (
        <div class="notice notice--warning" role="note" data-demo-notice>
          <Icon name="alert" />
          <p>
            <strong>Demonstration article.</strong> This article was created to demonstrate the TekkTech layout and
            has not been published as verified reporting. Any products named in example reviews are fictional, and
            nothing was physically tested. It is hidden from search engines and must be removed or replaced before
            launch.
          </p>
        </div>
      )}
      {sponsored && (
        <div class="notice notice--accent" role="note">
          <Icon name="info" />
          <p>
            <strong>Sponsored content{sponsorName ? ` from ${sponsorName}` : ''}.</strong> This article was paid for
            by the sponsor. TekkTech retained editorial control.{' '}
            <a href={withBase('/editorial-policy/')}>Read our editorial policy</a>.
          </p>
        </div>
      )}
      {affiliate && (
        <div class="notice" role="note">
          <Icon name="info" />
          <p>
            <strong>Affiliate links.</strong> This article contains links that may earn TekkTech a commission if you
            buy something, at no extra cost to you. This never affects our verdicts.{' '}
            <a href={withBase('/affiliate-disclosure/')}>How affiliate links work</a>.
          </p>
        </div>
      )}
    </div>
  )
}

<style>
  .disclosures {
    display: grid;
    gap: var(--space-3);
  }

  .disclosures :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
