---
/**
 * Article card. Variants:
 *   standard — image above text (grids)
 *   row      — small image beside text (secondary lists)
 *   compact  — text only (dense lists)
 *
 * The whole card is clickable through the headline link's stretched
 * pseudo-element, while the category label remains an independent link.
 */
import { articlePath, getCategory, typeLabel, type Article } from '../lib/articles.ts';
import { withBase } from '../lib/urls.ts';
import ArticleImage from './ArticleImage.astro';
import ArticleMeta from './ArticleMeta.astro';

interface Props {
  article: Article;
  variant?: 'standard' | 'row' | 'compact';
  headingLevel?: 2 | 3 | 4;
  showExcerpt?: boolean;
  showCategory?: boolean;
  sizes?: string;
}

const {
  article,
  variant = 'standard',
  headingLevel = 3,
  showExcerpt = variant === 'standard',
  showCategory = true,
  sizes = '(min-width: 76rem) 380px, (min-width: 48rem) 45vw, 100vw',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const category = getCategory(article.data.category);
---

<article class:list={['card', `card--${variant}`]}>
  {variant !== 'compact' && (
    <div class="card__media">
      <ArticleImage
        article={article}
        sizes={variant === 'row' ? '(min-width: 48rem) 180px, 120px' : sizes}
        widths={variant === 'row' ? [240, 360] : undefined}
        decorative
      />
    </div>
  )}
  <div class="card__body">
    <p class="eyebrow card__eyebrow">
      {showCategory && (
        <>
          <a href={withBase(`/${category.slug}/`)}>{category.shortName}</a>
          <span class="eyebrow__sep" aria-hidden="true">
            /
          </span>
        </>
      )}
      <span class="eyebrow__muted">{typeLabel(article.data.type)}</span>
    </p>
    <Heading class="card__title">
      <a href={articlePath(article)}>{article.data.title}</a>
    </Heading>
    {showExcerpt && <p class="card__excerpt">{article.data.excerpt}</p>}
    <ArticleMeta article={article} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .card__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.025);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .card__eyebrow {
    position: relative;
    z-index: 1;
  }

  .card__title {
    font-size: var(--text-lg);
    font-weight: 620;
    line-height: var(--leading-snug);
  }

  .card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__title a:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
  }

  .card:hover .card__title a {
    color: var(--color-accent);
  }

  .card__excerpt {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Row variant */
  .card--row {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .card--row .card__media {
    flex: none;
    width: 7.5rem;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
  }

  .card--row .card__title {
    font-size: var(--text-base);
  }

  @media (min-width: 48rem) {
    .card--row .card__media {
      width: 9.5rem;
    }
  }

  /* Compact variant */
  .card--compact {
    gap: 0;
  }

  .card--compact .card__title {
    font-size: var(--text-md);
  }
</style>
