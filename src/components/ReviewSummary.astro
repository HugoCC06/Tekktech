---
/**
 * "At a glance" box for reviews. Shows a score only when one exists and the
 * product was used hands-on; otherwise states plainly that the review is
 * based on research rather than testing.
 */
import type { ReviewData } from '../content.config.ts';
import { withBase } from '../lib/urls.ts';
import Icon from './Icon.astro';

interface Props {
  review: ReviewData;
}

const { review } = Astro.props;
const showScore = review.handsOn && typeof review.score === 'number';
---

<aside class="review-summary" aria-labelledby="review-summary-title">
  <header class="review-summary__header">
    <div>
      <p class="review-summary__kicker">At a glance</p>
      <h2 id="review-summary-title" class="review-summary__product">
        {review.productName}
      </h2>
      {review.productCategory && <p class="review-summary__category">{review.productCategory}</p>}
    </div>
    {showScore && (
      <div class="review-summary__score" aria-label={`Score: ${review.score} out of 10`}>
        <span class="review-summary__score-value">{review.score}</span>
        <span class="review-summary__score-max">/10</span>
      </div>
    )}
  </header>

  {review.summary && <p class="review-summary__verdict">{review.summary}</p>}

  {(review.strengths.length > 0 || review.weaknesses.length > 0) && (
    <div class="review-summary__lists">
      {review.strengths.length > 0 && (
        <div>
          <h3>Strengths</h3>
          <ul class="review-summary__list review-summary__list--pro">
            {review.strengths.map((item) => (
              <li>
                <Icon name="plus" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {review.weaknesses.length > 0 && (
        <div>
          <h3>Weaknesses</h3>
          <ul class="review-summary__list review-summary__list--con">
            {review.weaknesses.map((item) => (
              <li>
                <Icon name="minus" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  {(review.bestFor || review.avoidIf) && (
    <dl class="review-summary__fit">
      {review.bestFor && (
        <div>
          <dt>Consider it if</dt>
          <dd>{review.bestFor}</dd>
        </div>
      )}
      {review.avoidIf && (
        <div>
          <dt>Look elsewhere if</dt>
          <dd>{review.avoidIf}</dd>
        </div>
      )}
    </dl>
  )}

  <p class="review-summary__basis">
    <Icon name="info" />
    {review.handsOn ? (
      <span>
        We used this product ourselves. <a href={withBase('/how-we-review/')}>How we review</a>.
      </span>
    ) : (
      <span>
        This assessment is based on research into published specifications and documentation, not hands-on testing.{' '}
        <a href={withBase('/how-we-review/')}>How we review</a>.
      </span>
    )}
  </p>
</aside>

<style>
  .review-summary {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .review-summary__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .review-summary__kicker {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .review-summary__product {
    margin-top: var(--space-1);
    font-size: var(--text-xl);
  }

  .review-summary__category {
    margin-top: var(--space-1);
    color: var(--color-ink-3);
    font-size: var(--text-sm);
  }

  .review-summary__score {
    display: flex;
    align-items: baseline;
    flex: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .review-summary__score-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .review-summary__score-max {
    color: #b9bdc7;
    font-size: var(--text-sm);
  }

  .review-summary__verdict {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }

  .review-summary__lists {
    display: grid;
    gap: var(--space-6);
  }

  .review-summary h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }

  .review-summary__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .review-summary__list li {
    display: flex;
    gap: var(--space-2);
  }

  .review-summary__list :global(.icon) {
    width: 1rem;
    height: 1rem;
    margin-top: 0.2em;
    stroke-width: 2.25;
  }

  .review-summary__list--pro :global(.icon) {
    color: var(--color-success);
  }

  .review-summary__list--con :global(.icon) {
    color: var(--color-error);
  }

  .review-summary__fit {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .review-summary__fit dt {
    font-weight: 600;
  }

  .review-summary__fit dd {
    margin: var(--space-1) 0 0;
    color: var(--color-ink-2);
  }

  .review-summary__basis {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
  }

  .review-summary__basis :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 40rem) {
    .review-summary {
      padding: var(--space-8);
    }

    .review-summary__lists,
    .review-summary__fit {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
